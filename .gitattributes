# Default: text files use LF in the repository
* text=auto eol=lf

# Source / config
*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.cxx text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
